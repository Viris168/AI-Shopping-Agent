# See ARCHITECTURE.md §11. Copy to .env; never commit .env.

# Model access. Leave commented out to use an `ant auth login` profile instead.
# ANTHROPIC_API_KEY=sk-ant-...
MODEL_MAIN=claude-sonnet-5
MODEL_FAST=claude-haiku-4-5
# CLAUDE_EFFORT=low              # low | medium | high | xhigh | max
# MAX_OUTPUT_TOKENS=1024

# commerce-api
COMMERCE_API_URL=http://localhost:3000/api/v1
# SERVICE_TOKEN=                 # sent as X-Service-Token
# JWT_SECRET=                    # same secret commerce-api signs shopper tokens with
# JWT_ISSUER=commerce-api

REDIS_URL=redis://localhost:6379/0

STORE_NAME=our store
STOREFRONT_URL=http://localhost:3001
# RETURN_WINDOW_DAYS=30

# Limits
# MAX_TOOL_ROUNDS=6
# TURN_TIMEOUT_S=45
# MAX_MESSAGE_CHARS=2000
# RATE_LIMIT_PER_MIN=20
# TOKEN_BUDGET=300000

CORS_ORIGINS=http://localhost:5173   # the widget dev server
