# See ARCHITECTURE.md §11. Copy to .env; never commit .env.

# Model access: DeepSeek through its Anthropic-compatible API (the default).
# ANTHROPIC_API_KEY holds your DeepSeek key (platform.deepseek.com).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
MODEL_MAIN=deepseek-v4-pro
MODEL_FAST=deepseek-flash
# To use Claude instead: ANTHROPIC_BASE_URL= (empty), MODEL_MAIN=claude-sonnet-5,
# MODEL_FAST=claude-haiku-4-5, and an Anthropic key above.
# MODEL_ROUTING_ENABLED=false    # simple turns on MODEL_FAST (PLAN-19 M5); evals first
# ROUTING_PERCENT=0              # share of new conversations routed (M6 rollout), rest control
# CLAUDE_EFFORT=low              # low | medium | high | xhigh | max
# Cost estimates: USD per million tokens per model, copied from the provider's pricing page.
# MODEL_PRICES={"deepseek-v4-pro": {"input": 0, "cache_read": 0, "output": 0}, "deepseek-flash": {"input": 0, "cache_read": 0, "output": 0}}
# MAX_OUTPUT_TOKENS=1024

# commerce-api
COMMERCE_API_URL=http://localhost:3000/api/v1
# Required: sent as X-Service-Token; must equal commerce-api's SERVICE_TOKEN (32+ chars).
# Unset → commerce-api answers every tool call with 403.
SERVICE_TOKEN=
# JWT_SECRET=                    # same secret commerce-api signs shopper tokens with
# JWT_ISSUER=commerce-api

REDIS_URL=redis://localhost:6379/0

STORE_NAME=our store
STOREFRONT_URL=http://localhost:8080
# LINK_HOSTS=                   # more hosts replies may link to (comma-separated); others are removed
# RETURN_WINDOW_DAYS=30
# STORE_TZ=UTC                  # IANA zone, e.g. America/New_York: "today" and order dates

# Limits
# MAX_TOOL_ROUNDS=6
# TURN_TIMEOUT_S=45
# MAX_MESSAGE_CHARS=2000
# RATE_LIMIT_PER_MIN=20
# TOKEN_BUDGET=300000           # per conversation
# DAILY_TOKEN_BUDGET=1000000     # per shopper (per IP for guests) per UTC day; 0 = off
# LOCK_WAIT_S=10                 # confirm/cancel wait for a running turn on the conversation
# GUEST_RATE_LIMIT_PER_MIN=10
# Spend limits (PLAN-19 M7), USD of estimated cost from MODEL_PRICES; 0 = off.
# DAILY_SPEND_CAP_USD=5
# DAILY_SPEND_USER_USD=0.5
# DAILY_SPEND_GUEST_USD=0.1
# CONVERSATION_SPEND_USD=0.1
# NEW_CONVERSATIONS_PER_HOUR_USER=30
# NEW_CONVERSATIONS_PER_HOUR_GUEST=10
# PROVIDER_BALANCE_CHECK=true

CORS_ORIGINS=http://localhost:5173,http://localhost:8080   # widget dev server, storefront
# AGENT_ENABLED=true             # kill switch (Redis flag:agent_enabled=0 also turns it off)
# ROLLOUT_PERCENT=100            # share of browsers that see the widget
# IMAGES_ENABLED=false           # photos in chat (PLAN-20); Redis flag:images_enabled=0 turns them off
# IMAGES_ROLLOUT_PERCENT=100     # share of widget buckets shown the photo button (flag:images_rollout_percent)
# IMAGE_DAILY_LIMIT=20           # photos per shopper per UTC day; 0 = off for signed-in shoppers
# IMAGE_DAILY_LIMIT_GUEST=5      # per IP for guests; 0 = off for guests
# VOICE_ENABLED=false            # mic in the widget (PLAN-21; no audio reaches us); flag:voice_enabled=0 turns it off
# VOICE_ROLLOUT_PERCENT=100      # share of widget buckets shown the mic (flag:voice_rollout_percent)
# IMAGE_MAX_BYTES=1500000        # decoded upload
# IMAGE_TIMEOUT_S=15             # the describe call on MODEL_FAST

# Telemetry (infra/monitoring/README.md). Empty endpoint → nothing is exported.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20...
# DEPLOY_ENV=development
# TRACE_SAMPLE_RATIO=1.0
