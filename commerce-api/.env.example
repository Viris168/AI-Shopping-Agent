# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000

# Postgres from: docker run -d --name shop-db -p 127.0.0.1:5433:5432 -e POSTGRES_USER=shop -e POSTGRES_PASSWORD=shop -e POSTGRES_DB=shop postgres:16
DATABASE_URL=postgresql://shop:shop@localhost:5433/shop
# DB_POOL_SIZE=10
# DB_LOGGING=false
# RUN_MIGRATIONS_ON_BOOT=false

# Signs shopper tokens. agent-service must use the same value. 32+ characters; required in production.
JWT_SECRET=
# JWT_EXPIRES_IN=1h

# Comma-separated browser origins allowed to call the API (storefront, widget dev page).
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
STOREFRONT_URL=http://localhost:8080

# RATE_LIMIT_PER_MIN=120
# RETURN_WINDOW_DAYS=30
# LOG_LEVEL=info
