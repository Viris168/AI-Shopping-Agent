# For `docker compose up`. Copy to .env; never commit .env.
# Each service's own .env.example covers running it outside Docker.

# Signs shopper tokens; commerce-api and agent-service share it. 32+ characters.
# Generate: openssl rand -hex 32
JWT_SECRET=
# agent-service → commerce-api X-Service-Token. 32+ characters.
SERVICE_TOKEN=

# Required: the `ant auth login` profile is not available inside the container.
ANTHROPIC_API_KEY=
