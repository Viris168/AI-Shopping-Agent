{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "commerce-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "commerce-api",
        "run",
        "start:dev"
      ],
      "port": 3000
    },
    {
      "name": "agent-service",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd agent-service && exec env -u ANTHROPIC_BASE_URL -u CLAUDE_EFFORT .venv/bin/uvicorn app.main:app --reload --port 8000"
      ],
      "port": 8000
    },
    {
      "name": "widget",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "widget",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "storefront",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "storefront",
        "run",
        "dev"
      ],
      "port": 8080
    }
  ]
}
